# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Data: raw letter images, recorded/segmented action clips, source videos (incl. third-party YouTube
# videos and team members' faces), generated libraries. The repo is public: never commit these.
data/
data/raw/
data/actions/
data/sources/

# Videos and photos anywhere, except our own team's reference media in assets/isl/
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.jpg
*.jpeg
!assets/isl/*.jpg
!assets/isl/actions/*.mp4

# Segment contact sheets = frames of the source videos (faces, YouTube content): local review only
reports/segments/

# models/: only the landmark-number libraries are committed. The handwriting model holds rendered font
# bitmaps and is rebuilt automatically by the app when missing.
models/handwriting_model.npz

# Reports (accuracy.md/.json + charts) ARE committed — do not ignore reports/

# Editors / OS — share only the workspace interpreter settings
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
.DS_Store

# Streamlit local secrets
.streamlit/secrets.toml

# Local Claude Code entry point (imports SIGN_BRIDGE.md); not part of the repo
CLAUDE.md
